# SPDX-License-Identifier: GPL-3.0-or-later
#
# Arch package for this machine, from the native build in target/release.
# Driven by `cgs local-build --env TYPE=arch`, which builds first and sets
# LUNE_REPO and LUNE_PKGVER.

pkgname=lune-voice
pkgver=${LUNE_PKGVER:?set LUNE_PKGVER}
pkgrel=1
pkgdesc='Offline voice dictation: hotkey, speak, text in the active app'
arch=('x86_64')
url='https://github.com/CoderDayton/lune-voice'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'gtk-layer-shell' 'libayatana-appindicator' 'alsa-lib' 'vulkan-icd-loader')
install=lune-voice.install
options=('!debug')

package() {
  local repo=${LUNE_REPO:?set LUNE_REPO}
  local tauri="$repo/desktop-ui/src-tauri"

  install -Dm755 "$repo/target/release/lune-voice" "$pkgdir/usr/bin/lune-voice"

  # Tauri finds resources at <prefix>/lib/<productName> for a binary in
  # <prefix>/bin.
  install -Dm644 -t "$pkgdir/usr/lib/LuneVoice" \
    "$repo/THIRD_PARTY_NOTICES.md" "$repo/THIRD_PARTY_LICENSES.md"

  install -Dm644 "$repo/assets/udev/70-lune-voice-input.rules" \
    "$pkgdir/usr/lib/udev/rules.d/70-lune-voice-input.rules"

  # hicolor sizes must be the real pixel size: 128x128@2x is 256px.
  install -Dm644 "$tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/lune-voice.png"
  install -Dm644 "$tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/lune-voice.png"
  install -Dm644 "$tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/lune-voice.png"

  # StartupWMClass is the binary name: GTK derives the window's app id from it.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/lune-voice.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Lune Voice
Comment=Offline voice dictation powered by local AI
Exec=lune-voice
Icon=lune-voice
StartupWMClass=lune-voice
Terminal=false
Categories=Utility;
EOF

  install -Dm644 "$repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
