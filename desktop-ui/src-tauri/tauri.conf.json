{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "LuneVoice",
  "version": "0.1.0",
  "identifier": "com.lunevoice.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lune Voice",
        "url": "index.html",
        "create": false,
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CoderDayton/lune-voice/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4N0VEQTE4NDU2OTFGQzkKUldUSkgybEZHTnArMkJ1SFpmOThWNEhPUWFXRGdpUDlZVnFiZCtrUmw2Mm82NWF0ZERxWGh5ZGoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Offline voice dictation powered by local AI",
    "longDescription": "Lune Voice turns speech into text locally on your computer. No cloud, no accounts, no internet required. Press a hotkey, speak, and text appears in any app.",
    "copyright": "© 2026 Lune Voice",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/99-lune-voice-uinput.rules": "../../assets/udev/99-lune-voice-uinput.rules"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"],
        "files": {
          "/usr/lib/udev/rules.d/99-lune-voice-uinput.rules": "../../assets/udev/99-lune-voice-uinput.rules"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
